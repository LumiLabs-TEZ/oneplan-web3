// ---------------------------------------------------------------------------
// Missions & Rewards (spark ⚡ ledger)
//
// Append-only earn side. Balance is never stored — it is derived as
// SUM(mission_completion.reward_amount) − SUM(reward_redemption.price) inside
// the redeem transaction. `missionId` is a TS string union (mission-defs.ts),
// not a Prisma enum, so adding missions needs no migration. Idempotency is
// enforced by two partial unique indexes added in raw SQL in the migration
// (a plain @@unique over nullable external_ref would not dedupe — Postgres
// treats NULLs as distinct):
//   UNIQUE (user_id, mission_id)               WHERE external_ref IS NULL
//   UNIQUE (user_id, mission_id, external_ref) WHERE external_ref IS NOT NULL
// `periodKey` carries the week/month key used for cap counting.
model MissionCompletion {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  missionId    String   @map("mission_id") @db.VarChar(40)
  rewardAmount Int      @map("reward_amount")
  externalRef  String?  @map("external_ref") @db.VarChar(64)
  periodKey    String?  @map("period_key") @db.VarChar(16)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
  @@index([userId, missionId, periodKey])
  @@map("mission_completion")
}

// Append-only spend side (reward shop). Shop items may be redeemed repeatedly
// (per-item caps are enforced in code by counting rows per periodKey — the
// quarter key for Pro items). listingId is set for market_unlock only; the
// acquisition's own [userId, listingId] unique prevents per-listing repeats.
model RewardRedemption {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  itemId    String   @map("item_id") @db.VarChar(32)
  price     Int
  listingId Int?     @map("listing_id")
  periodKey String?  @map("period_key") @db.VarChar(16)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
  @@index([userId, itemId, periodKey])
  @@map("reward_redemption")
}

// Admin-editable overrides for the missions/reward-shop numbers hardcoded in
// mission-defs.ts (same k/v pattern as TelegramSetting; absence of a row =
// code default, reset = delete). Keys: mission.<id>.reward, mission.<id>.cap,
// shop.<id>.price, shop.<id>.capPerQuarter. Values are integers as strings.
model MissionSetting {
  key       String   @id @db.VarChar(64)
  value     String
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("mission_setting")
}

