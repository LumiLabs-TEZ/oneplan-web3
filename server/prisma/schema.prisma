// Persistent scan-credit ledger. One row per grant (signup bonus, Pro weekly
// grant, purchase pack, pay_once, admin adjustment). `amount` is the immutable
// original grant; `remaining` is decremented on consumption (DB CHECK keeps it
// in [0, amount]). `expiresAt` is nullable and unused in v1 but lets expiry be
// added later with no migration. Dedup is enforced by three partial unique
// indexes added in raw SQL in the migration (a plain @@unique over a nullable
// column would NOT dedupe purchases — Postgres treats NULLs as distinct):
//   UNIQUE (user_id, external_ref, period_key) WHERE period_key IS NOT NULL
//   UNIQUE (user_id, external_ref)             WHERE source IN ('purchase','pay_once')
//   UNIQUE (user_id)                           WHERE source = 'signup_bonus'
model ScanCreditGrant {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  source      String    @db.VarChar(32)
  productId   String?   @map("product_id") @db.VarChar(255)
  amount      Int
  remaining   Int
  grantedAt   DateTime  @default(now()) @map("granted_at") @db.Timestamptz(6)
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz(6)
  externalRef String?   @map("external_ref") @db.VarChar(255)
  periodKey   String?   @map("period_key") @db.VarChar(255)
  // Set when an Apple refund/revoke claws back this grant's unused credits.
  // Doubles as the clawback idempotency guard and an audit signal (revoked by
  // refund vs spent down naturally). Nullable; mirrors expiresAt.
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)
  // Apple environment ('Production'/'Sandbox') the grant originated from, copied
  // from the originating SubscriptionTransaction so sandbox (TestFlight / App
  // Review) credits are filterable from real ones. Null for non-purchase grants
  // (signup_bonus, admin_adjustment), which carry no environment dimension.
  environment String?   @map("environment") @db.VarChar(50)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  consumptions ScanCreditConsumption[]

  @@index([userId, grantedAt])
  @@index([userId, remaining])
  @@map("scan_credit_grant")
}

// One row per consumed scan, keyed by the PinExtractionSession id so consume
// and refund are idempotent (mirrors the old usage-row semantics). `refundedAt`
// set when the extraction FAILED/CANCELLED/DONE+fromCache; the grant's
// `remaining` is restored in the same transaction.
model ScanCreditConsumption {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  grantId    Int       @map("grant_id")
  sessionId  String    @unique @map("session_id")
  amount     Int       @default(1)
  consumedAt DateTime  @default(now()) @map("consumed_at") @db.Timestamptz(6)
  refundedAt DateTime? @map("refunded_at") @db.Timestamptz(6)

  grant ScanCreditGrant @relation(fields: [grantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, consumedAt])
  @@map("scan_credit_consumption")
}

