/// One Solana vault per trip. Mirrors the on-chain TripVault PDA; the chain is
/// authoritative and this row is corrected to match it, never the reverse.
/// One cash debt between two trip members, confirmed as received.
///
/// The vault can pay out but cannot collect, so whatever it does not cover is
/// handed over in cash. Only the creditor may confirm: a debtor who could clear
/// their own debt by asserting they paid it makes the record worthless.
///
/// Derived from the ledger rather than stored up front, so a row exists only
/// once someone has confirmed receipt.
model VaultCashSettlement {
  id          Int      @id @default(autoincrement())
  tripVaultId Int      @map("trip_vault_id")
  /// Who owes the money.
  fromUserId  Int      @map("from_user_id")
  /// Who is owed it, and the only person who may confirm.
  toUserId    Int      @map("to_user_id")
  amountMicro BigInt   @map("amount_micro")
  confirmedAt DateTime @default(now()) @map("confirmed_at") @db.Timestamptz(6)

  tripVault TripVault @relation(fields: [tripVaultId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  fromUser  User      @relation("cashSettlementFrom", fields: [fromUserId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  toUser    User      @relation("cashSettlementTo", fields: [toUserId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tripVaultId, fromUserId, toUserId])
  @@map("vault_cash_settlement")
}

