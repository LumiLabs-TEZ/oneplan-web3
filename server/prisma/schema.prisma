model WalletWithdrawal {
  id                      Int      @id @default(autoincrement())
  userId                  Int      @map("user_id")
  amountMicro             BigInt   @map("amount_micro")
  /// The transfer also opened the recipient's token account (fee payer pays rent).
  createsRecipientAccount Boolean  @default(false) @map("creates_recipient_account")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, createdAt])
  @@map("wallet_withdrawal")
}

/// Read-optimised mirror of an on-chain operation plus its fiat payout leg.
model VaultTransaction {
  id               Int              @id @default(autoincrement())
  tripVaultId      Int              @map("trip_vault_id")
  userId           Int?             @map("user_id")
  kind             VaultTxKind      @map("kind")
  /// VAULT: the group wallet paid. PERSONAL: the member's own wallet paid and the
  /// group owes them their share (spend only).
  source           VaultTxSource    @default(VAULT) @map("source")
  status           VaultTxStatus    @default(PENDING) @map("status")
  amountMicro      BigInt           @map("amount_micro")
  signature        String?          @map("signature") @db.VarChar(128)
  /// Deterministic idempotency key for the payout leg, derived from this row id.
  payoutRef        String?          @unique @map("payout_ref") @db.VarChar(64)
  payoutStatus     String?          @map("payout_status") @db.VarChar(32)
  proposalPda      String?          @map("proposal_pda") @db.VarChar(64)
  /// When the second member's approval executed the proposal and the money
  /// actually left the vault. Null while a proposal is still waiting, which is
  /// what keeps the reconcile job from paying a merchant for an unmoved spend.
  approvedAt       DateTime?        @map("approved_at")
  expenseId        Int?             @unique @map("expense_id")
  bankBin          String?          @map("bank_bin") @db.VarChar(16)
  bankAccount      String?          @map("bank_account") @db.VarChar(64)
  amountVnd        BigInt?          @map("amount_vnd")
  failureCode      String?          @map("failure_code") @db.VarChar(64)
  /// Receipt fields, captured from the quote. They are priced at that moment and
  /// cannot be recomputed later: the FX rate moves, and the recipient name comes
  /// from the payout provider rather than from the QR code.
  recipientName    String?          @map("recipient_name") @db.VarChar(255)
  /// The scanned code, kept so a payment can be repeated without scanning
  /// again. Bank and account alone are not enough: the payload also carries the
  /// service and currency fields the decoder expects.
  qrPayload        String?          @map("qr_payload") @db.VarChar(512)
  feeMicro         BigInt?          @map("fee_micro")
  rate             String?          @map("rate") @db.VarChar(32)
  note             String?          @map("note") @db.VarChar(255)
  /// Expense details captured at prepare time. The expense itself is only
  /// created once the payout confirms, which can be minutes later in the
  /// reconciliation cron, so they have to survive the gap.
  expenseName      String?          @map("expense_name") @db.VarChar(255)
  expenseCategory  ExpenseCategory? @map("expense_category")
  shareWithUserIds Int[]            @map("share_with_user_ids")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  tripVault        TripVault        @relation(fields: [tripVaultId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user             User?            @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  expense          Expense?         @relation(fields: [expenseId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  // `signature` is unique WHERE signature IS NOT NULL — a partial unique index
  // added in raw SQL in the migration (Prisma cannot express it). It is what
  // stops one signed transaction being booked twice (audit S7).
  @@index([tripVaultId, status])
  @@index([status, createdAt])
  @@map("vault_transaction")
}

/**
 * ------------------------- Fare Watch (Radar) -------------------------
 */
// "Săn vé": guest (web, phone-only) or app user places a fare-watch order;
// a cron engine checks cached fares and pings Zalo ZNS / APNs when the price
// crosses the target. Spec: docs/fare-watch-spec.md.

enum FareWatchStatus {
  ACTIVE
  PAUSED
  TRIGGERED
  EXPIRED
  CANCELLED
}

enum FareTripType {
  ONE_WAY
  ROUND_TRIP
}

enum FareAlertChannel {
  ZNS
  PUSH
  BOTH
}

model FareWatchOrder {
  id            Int       @id @default(autoincrement())
  publicId      String    @unique @default(cuid()) @map("public_id")
  // Owner: an app user OR a web guest identified by phone. No FK relation on
  // purpose: guests have no User row, and orders must survive user deletion.
  userId        Int?      @map("user_id")
  // Display name for ZNS personalization (Zalo requires a customer-name
  // param in alert templates). Optional for app users.
  name          String?   @db.VarChar(60)
  phone         String?   @db.VarChar(16)
  phoneVerified Boolean   @default(false) @map("phone_verified")
  // OTP kept as a hash; cleared after verification.
  otpHash       String?   @map("otp_hash") @db.VarChar(64)
  otpExpiresAt  DateTime? @map("otp_expires_at") @db.Timestamptz(6)
  otpAttempts   Int       @default(0) @map("otp_attempts")

  origin      String       @db.VarChar(3)
  destination String       @db.VarChar(3)
  tripType    FareTripType @default(ONE_WAY) @map("trip_type")
  dateFrom    DateTime     @map("date_from") @db.Date
  dateTo      DateTime     @map("date_to") @db.Date
  returnFrom  DateTime?    @map("return_from") @db.Date
  returnTo    DateTime?    @map("return_to") @db.Date

  targetPrice Int?             @map("target_price")
  autoTarget  Boolean          @default(false) @map("auto_target")
  channel     FareAlertChannel @default(ZNS)
  tripId      Int?             @map("trip_id")

  status            FareWatchStatus @default(ACTIVE)
  expiresAt         DateTime        @map("expires_at") @db.Timestamptz(6)
  lastNotifiedAt    DateTime?       @map("last_notified_at") @db.Timestamptz(6)
  lastNotifiedPrice Int?            @map("last_notified_price")
  notifyCount       Int             @default(0) @map("notify_count")
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  alerts FareAlertLog[]

  @@index([status, expiresAt])
  @@index([origin, destination, dateFrom])
  @@index([userId])
  @@index([phone])
  @@map("fare_watch_order")
}

// Append-only fare history: powers alerts today and the 90-day price
// sparkline / "good price" suggestion tomorrow.
model FareQuote {
  id          Int       @id @default(autoincrement())
  origin      String    @db.VarChar(3)
  destination String    @db.VarChar(3)
  departDate  DateTime  @map("depart_date") @db.Date
  returnDate  DateTime? @map("return_date") @db.Date
  airline     String    @db.VarChar(8)
  price       Int
  source      String    @db.VarChar(24)
  deepLink    String?   @map("deep_link")
  fetchedAt   DateTime  @default(now()) @map("fetched_at") @db.Timestamptz(6)

  alerts FareAlertLog[]

  @@index([origin, destination, departDate, fetchedAt])
  @@map("fare_quote")
}

model FareAlertLog {
  id        Int              @id @default(autoincrement())
  orderId   Int              @map("order_id")
  order     FareWatchOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  quoteId   Int?             @map("quote_id")
  quote     FareQuote?       @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  price     Int
  channel   FareAlertChannel
  znsMsgId  String?          @map("zns_msg_id") @db.VarChar(64)
  status    String           @db.VarChar(16)
  sentAt    DateTime         @default(now()) @map("sent_at") @db.Timestamptz(6)
  clickedAt DateTime?        @map("clicked_at") @db.Timestamptz(6)

  @@index([orderId, sentAt])
  @@map("fare_alert_log")
}

// Zalo OA OAuth state. Zalo ROTATES the refresh token on every use, so the
// freshest pair must be persisted; a stale refresh token is dead after one
// reuse. Single row (id=1), upserted by ZnsService.
model ZaloOauthToken {
  id           Int      @id @default(1)
  accessToken  String   @map("access_token")
  refreshToken String   @map("refresh_token")
  expiresAt    DateTime @map("expires_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("zalo_oauth_token")
}
