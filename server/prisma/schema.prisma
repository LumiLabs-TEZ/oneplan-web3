generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       Int                       @id @default(autoincrement())
  email                    String                    @unique @map("email") @db.VarChar(255)
  displayName              String                    @map("display_name") @db.VarChar(100)
  avatarUrl                String?                   @map("avatar_url") @db.VarChar(500)
  createdAt                DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  friendCode               String?                   @unique @map("friend_code") @db.VarChar(64)
  autoRenewEnabled         Boolean                   @default(false) @map("auto_renew_enabled")
  appAccountToken          String?                   @unique @map("app_account_token") @db.Uuid
  gracePeriodExpiresAt     DateTime?                 @map("grace_period_expires_at") @db.Timestamptz(6)
  originalTransactionId    String?                   @unique @map("original_transaction_id") @db.VarChar(255)
  subscriptionExpiresAt    DateTime?                 @map("subscription_expires_at") @db.Timestamptz(6)
  subscriptionProductId    String?                   @map("subscription_product_id") @db.VarChar(255)
  subscriptionStatus       SubscriptionStatus        @default(NONE) @map("subscription_status")
  preferredCurrency        Currency                  @default(USD) @map("preferred_currency")
  // Engagement-push personalization + Apple-4.5.4 marketing consent.
  // `locale` drives the language of AI-generated engagement copy.
  // `engagementPushEnabled` is the opt-out; `engagementConsentedAt` is the
  // auditable opt-IN — no engagement push is sent until consent is stamped.
  locale                   EngagementLocale          @default(EN) @map("locale")
  engagementPushEnabled    Boolean                   @default(true) @map("engagement_push_enabled")
  engagementConsentedAt    DateTime?                 @map("engagement_consented_at") @db.Timestamptz(6)
  authAccounts             AuthAccount[]
  budgetPayments           BudgetPayment[]
  chatMessages             ChatMessage[]
  deviceTokens             DeviceToken[]
  expenses                 Expense[]
  expenseShares            ExpenseShare[]
  receivedFriendRequests   FriendRequest[]           @relation("FriendRequestReceiver")
  sentFriendRequests       FriendRequest[]           @relation("FriendRequestSender")
  friendshipsAsA           Friendship[]              @relation("FriendshipUserA")
  friendshipsAsB           Friendship[]              @relation("FriendshipUserB")
  acquisitions             MarketplaceAcquisition[]
  marketplaceListings      MarketplaceListing[]      @relation("ListingCreator")
  marketplaceRatings       MarketplaceRating[]
  recentLocations          RecentLocation[]
  refreshTokens            RefreshToken[]
  subscriptionTransactions SubscriptionTransaction[]
  storeNotifications       StoreNotification[]
  createdTrips             Trip[]                    @relation("TripCreator")
  activities               TripActivity[]
  tripMembers              TripMember[]
  tripPhotos               TripPhoto[]
  tripNotes                TripNote[]
  planItemMembers          TripPlanItemMember[]
  analyticsSessions        AnalyticsSession[]        @relation("UserAnalyticsSessions")
  analyticsEvents          AnalyticsEvent[]          @relation("UserAnalyticsEvents")
  boards                   Board[]
  pinExtractionSessions    PinExtractionSession[]
  scanCreditGrants         ScanCreditGrant[]
  tripRequests             TripRequest[]
  engagementNotifications  EngagementNotification[]
  giftsReceived            GiftLog[]
  invitedTripMembers       TripMember[]              @relation("TripMemberInviter")
  missionCompletions       MissionCompletion[]
  rewardRedemptions        RewardRedemption[]
  walletAccount            WalletAccount?
  walletWithdrawals        WalletWithdrawal[]
  vaultTransactions        VaultTransaction[]
  cashSettlementsOwed      VaultCashSettlement[]     @relation("cashSettlementFrom")
  cashSettlementsReceived  VaultCashSettlement[]     @relation("cashSettlementTo")
  tripEndRequestsStarted   TripEndRequest[]          @relation("TripEndRequester")
  tripEndVotes             TripEndVote[]

  @@map("user")
}

// A read-only snapshot of everything we knew about a user, taken at the moment
// they delete their account. The account itself is still really deleted (the
// User row and its data are removed as before); this archive keeps the
// identified copy for a limited window so support/admin can look it up, and a
// cron purges it after DELETED_USER_RETENTION_DAYS (30).
//
// Deliberately has NO relation to User: the FK would either block the delete or
// cascade the archive away, and the whole point is that it outlives the user.
model DeletedUserArchive {
  id             Int      @id @default(autoincrement())
  originalUserId Int      @map("original_user_id")
  email          String   @map("email") @db.VarChar(255)
  displayName    String   @map("display_name") @db.VarChar(255)
  // Full snapshot: profile, auth providers, trips, expenses, subscription,
  // scan credits, gifts and an activity summary.
  snapshot       Json     @map("snapshot")
  deletedAt      DateTime @default(now()) @map("deleted_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([deletedAt])
  @@index([email])
  @@map("deleted_user_archive")
}

// Admin loyalty gifts (scan credits and/or a Pro package). One row per gift,
// for the admin "Gift" history. The grant of record still lives in
// ScanCreditGrant (scans) / the User subscription columns (package); this is
// the human-readable audit log.
model GiftLog {
  id                    Int       @id @default(autoincrement())
  recipientUserId       Int       @map("recipient_user_id")
  recipientEmail        String    @map("recipient_email") @db.VarChar(255)
  adminEmail            String    @map("admin_email") @db.VarChar(255)
  scans                 Int       @default(0) @map("scans")
  package               String?   @map("package") @db.VarChar(32)
  subscriptionExpiresAt DateTime? @map("subscription_expires_at") @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  recipient             User      @relation(fields: [recipientUserId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([recipientUserId])
  @@index([createdAt])
  @@map("gift_log")
}

model AuthAccount {
  id             Int          @id @default(autoincrement())
  userId         Int          @map("user_id")
  provider       AuthProvider @map("provider")
  providerUserId String       @map("provider_user_id") @db.VarChar(255)
  passwordHash   String?      @map("password_hash") @db.VarChar(255)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("auth_account")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  jti       String   @unique @map("jti") @db.VarChar(36)
  family    String   @map("family") @db.VarChar(36)
  isRevoked Boolean  @default(false) @map("is_revoked")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
  @@index([family])
  @@map("refresh_token")
}

model Country {
  id                  Int                  @id @default(autoincrement())
  name                String               @map("name") @db.VarChar(100)
  iso3                String?              @map("iso3") @db.Char(3)
  iso2                String?              @map("iso2") @db.Char(2)
  numericCode         String?              @map("numeric_code") @db.Char(3)
  phoneCode           String?              @map("phone_code") @db.VarChar(255)
  capital             String?              @map("capital") @db.VarChar(255)
  currency            String?              @map("currency") @db.VarChar(255)
  currencyName        String?              @map("currency_name") @db.VarChar(255)
  currencySymbol      String?              @map("currency_symbol") @db.VarChar(255)
  tld                 String?              @map("tld") @db.VarChar(255)
  native              String?              @map("native") @db.VarChar(255)
  region              String?              @map("region") @db.VarChar(255)
  subRegion           String?              @map("sub_region") @db.VarChar(255)
  timezones           String?              @map("timezones")
  translations        String?              @map("translations")
  latitude            Decimal?             @map("latitude") @db.Decimal(10, 8)
  longitude           Decimal?             @map("longitude") @db.Decimal(11, 8)
  emoji               String?              @map("emoji") @db.VarChar(191)
  emojiU              String?              @map("emoji_u") @db.VarChar(191)
  createdAt           DateTime?            @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  flag                Boolean              @default(true) @map("flag")
  wikiDataId          String?              @map("wiki_data_id") @db.VarChar(255)
  boards              Board[]
  cities              City[]
  marketplaceListings MarketplaceListing[]
  states              State[]
  trips               Trip[]
  tripRequests        TripRequest[]

  @@map("country")
}

model State {
  id                  Int                  @id @default(autoincrement())
  name                String               @map("name") @db.VarChar(255)
  countryCode         String               @map("country_code") @db.Char(2)
  fipsCode            String?              @map("fips_code") @db.VarChar(255)
  iso2                String?              @map("iso2") @db.VarChar(255)
  type                String?              @map("type") @db.VarChar(191)
  latitude            Decimal?             @map("latitude") @db.Decimal(10, 8)
  longitude           Decimal?             @map("longitude") @db.Decimal(11, 8)
  createdAt           DateTime?            @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  flag                Boolean              @default(true) @map("flag")
  wikiDataId          String?              @map("wiki_data_id") @db.VarChar(255)
  countryId           Int                  @map("country_id")
  boards              Board[]
  cities              City[]
  marketplaceListings MarketplaceListing[]
  country             Country              @relation(fields: [countryId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "country_region_final")
  trips               Trip[]
  tripRequests        TripRequest[]

  @@index([countryId])
  @@map("state")
}

model City {
  id                  Int                  @id @default(autoincrement())
  name                String               @map("name") @db.VarChar(255)
  stateCode           String               @map("state_code") @db.VarChar(255)
  countryCode         String               @map("country_code") @db.Char(2)
  latitude            Decimal              @map("latitude") @db.Decimal(10, 8)
  longitude           Decimal              @map("longitude") @db.Decimal(11, 8)
  createdAt           DateTime?            @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime?            @updatedAt @map("updated_at") @db.Timestamptz(6)
  flag                Boolean              @default(true) @map("flag")
  wikiDataId          String?              @map("wiki_data_id") @db.VarChar(255)
  countryId           Int                  @map("country_id")
  stateId             Int                  @map("state_id")
  country             Country              @relation(fields: [countryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  state               State                @relation(fields: [stateId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  boards              Board[]
  marketplaceListings MarketplaceListing[]
  trips               Trip[]
  tripRequests        TripRequest[]

  @@index([stateId])
  @@index([countryId])
  @@map("city")
}

model Trip {
  id                   Int                 @id @default(autoincrement())
  name                 String              @map("name") @db.VarChar(255)
  coverImageUrl        String?             @map("cover_image_url") @db.VarChar(500)
  status               TripStatus          @default(PLANNING) @map("status")
  startDate            DateTime?           @map("start_date") @db.Date
  endDate              DateTime?           @map("end_date") @db.Date
  // Stamped by the auto-start cron whether it started or skipped (conflict)
  // the trip, so a blocked trip is attempted once, not every tick.
  autoStartAttemptedAt DateTime?           @map("auto_start_attempted_at") @db.Timestamptz(6)
  inviteCode           String?             @unique @map("invite_code") @db.VarChar(64)
  createdById          Int                 @map("created_by_id")
  cityId               Int?                @map("city_id")
  stateId              Int?                @map("state_id")
  countryId            Int?                @map("country_id")
  currency             Currency            @default(VND) @map("currency")
  localCurrencies      Currency[]          @default([]) @map("local_currencies")
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  marketplaceListingId Int?                @map("marketplace_listing_id")
  // Fixed at creation: true only if the creator was web3-eligible (non-VN IP,
  // server web3 on). Members of a web3 trip use the vault whatever their IP.
  web3                 Boolean             @default(false) @map("web3")
  marketplaceListing   MarketplaceListing? @relation(fields: [marketplaceListingId], references: [id], onDelete: SetNull)
  budgets              Budget[]
  chatMessages         ChatMessage[]
  expenses             Expense[]
  city                 City?               @relation(fields: [cityId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  country              Country?            @relation(fields: [countryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdBy            User                @relation("TripCreator", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  state                State?              @relation(fields: [stateId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  activities           TripActivity[]
  members              TripMember[]
  photos               TripPhoto[]
  notes                TripNote[]
  planItems            TripPlanItem[]
  vault                TripVault?
  endRequest           TripEndRequest?

  @@index([createdById])
  @@index([cityId])
  @@index([stateId])
  @@index([countryId])
  @@index([status])
  @@map("trip")
}

model TripRequest {
  id                   Int                 @id @default(autoincrement())
  userId               Int                 @map("user_id")
  cityId               Int?                @map("city_id")
  stateId              Int?                @map("state_id")
  countryId            Int?                @map("country_id")
  tag                  ListingTag          @map("tag")
  budget               Decimal?            @map("budget") @db.Decimal(18, 2)
  currency             Currency            @default(VND) @map("currency")
  participantCount     Int?                @map("participant_count")
  dayCount             Int?                @map("day_count")
  description          String?             @map("description")
  status               TripRequestStatus   @default(OPEN) @map("status")
  fulfilledByListingId Int?                @map("fulfilled_by_listing_id")
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  city                 City?               @relation(fields: [cityId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  state                State?              @relation(fields: [stateId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  country              Country?            @relation(fields: [countryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fulfilledByListing   MarketplaceListing? @relation(fields: [fulfilledByListingId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([fulfilledByListingId])
  @@map("trip_request")
}

model TripMember {
  id                        Int            @id @default(autoincrement())
  tripId                    Int            @map("trip_id")
  userId                    Int            @map("user_id")
  inviteStatus              InviteStatus   @default(PENDING) @map("invite_status")
  role                      TripMemberRole @default(MEMBER)
  /// Host marked this member's vault debt cleared off-chain so they may leave.
  vaultLeaveClearedAt       DateTime?      @map("vault_leave_cleared_at") @db.Timestamptz(6)
  /// Member announced leave; host must confirm (and payout if net > 0).
  vaultLeaveRequestedAt     DateTime?      @map("vault_leave_requested_at") @db.Timestamptz(6)
  /// Signed net (micro-USDC) snapshotted at announce time.
  vaultLeaveRequestNetMicro BigInt?        @map("vault_leave_request_net_micro")
  joinedAt                  DateTime?      @map("joined_at") @db.Timestamptz(6)
  createdAt                 DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  lastSeenChatMessageId     Int?           @map("last_seen_chat_message_id")
  // Who brought this member in. Set to the inviting member on inviteMembers and
  // to the trip creator on joinTrip-by-code. Null for the creator's own row and
  // for legacy rows. Drives the friend_joined / invite_2 missions.
  invitedById               Int?           @map("invited_by_id")
  trip                      Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user                      User           @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  invitedBy                 User?          @relation("TripMemberInviter", fields: [invitedById], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([tripId, userId])
  @@index([tripId])
  @@index([userId])
  @@index([invitedById])
  @@map("trip_member")
}

model Budget {
  id               Int              @id @default(autoincrement())
  tripId           Int              @map("trip_id")
  name             String           @map("name") @db.VarChar(255)
  amount           Decimal          @map("amount") @db.Decimal(18, 2)
  perPersonAmount  Decimal?         @map("per_person_amount") @db.Decimal(18, 2)
  scope            PlanScope        @default(GROUP) @map("scope")
  // Nullable: budgets created before this column existed have no category, and
  // the field stays optional on create.
  category         ExpenseCategory? @map("category")
  originalAmount   Decimal?         @map("original_amount") @db.Decimal(18, 2)
  originalCurrency Currency?        @map("original_currency")
  exchangeRate     Decimal?         @map("exchange_rate") @db.Decimal(18, 8)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  trip             Trip             @relation(fields: [tripId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  payments         BudgetPayment[]

  @@index([tripId])
  @@map("budget")
}

model BudgetPayment {
  id        Int       @id @default(autoincrement())
  budgetId  Int       @map("budget_id")
  userId    Int       @map("user_id")
  amount    Decimal   @map("amount") @db.Decimal(18, 2)
  isPaid    Boolean   @default(false) @map("is_paid")
  paidAt    DateTime? @map("paid_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  budget    Budget    @relation(fields: [budgetId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([budgetId, userId])
  @@index([budgetId])
  @@index([userId])
  @@map("budget_payment")
}

model Expense {
  id               Int               @id @default(autoincrement())
  tripId           Int               @map("trip_id")
  paidById         Int?              @map("paid_by_id")
  name             String            @map("name") @db.VarChar(255)
  amount           Decimal           @map("amount") @db.Decimal(18, 2)
  category         ExpenseCategory   @default(OTHER) @map("category")
  note             String?           @map("note") @db.VarChar(500)
  receiptUrl       String?           @map("receipt_url") @db.VarChar(500)
  originalAmount   Decimal?          @map("original_amount") @db.Decimal(18, 2)
  originalCurrency Currency?         @map("original_currency")
  exchangeRate     Decimal?          @map("exchange_rate") @db.Decimal(18, 8)
  expenseDate      DateTime          @default(now()) @map("expense_date") @db.Timestamptz(6)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  paidBy           User?             @relation(fields: [paidById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  trip             Trip              @relation(fields: [tripId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  shares           ExpenseShare[]
  vaultTransaction VaultTransaction?

  @@index([tripId])
  @@index([paidById])
  @@index([category])
  @@index([expenseDate])
  @@map("expense")
}

model ExpenseShare {
  id          Int       @id @default(autoincrement())
  expenseId   Int       @map("expense_id")
  userId      Int       @map("user_id")
  shareAmount Decimal   @map("share_amount") @db.Decimal(18, 2)
  isSettled   Boolean   @default(false) @map("is_settled")
  settledAt   DateTime? @map("settled_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  expense     Expense   @relation(fields: [expenseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([expenseId, userId])
  @@index([expenseId])
  @@index([userId])
  @@map("expense_share")
}

model TripPlanItem {
  id                     Int                      @id @default(autoincrement())
  tripId                 Int                      @map("trip_id")
  planDate               DateTime?                @map("plan_date") @db.Date
  title                  String                   @map("title") @db.VarChar(255)
  description            String?                  @map("description") @db.VarChar(500)
  location               String?                  @map("location") @db.VarChar(500)
  latitude               Float?                   @map("latitude")
  longitude              Float?                   @map("longitude")
  address                String?                  @map("address") @db.VarChar(500)
  startTime              String?                  @map("start_time") @db.VarChar(5)
  category               ExpenseCategory?         @map("category")
  voiceUrl               String?                  @map("voice_url") @db.VarChar(500)
  voiceDuration          Int?                     @map("voice_duration")
  imageUrls              String[]                 @default([]) @map("image_urls")
  sortOrder              Int                      @default(0) @map("sort_order")
  createdAt              DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  dayNumber              Int?                     @map("day_number")
  notifiedAt             DateTime?                @map("notified_at") @db.Timestamptz(6)
  plan_reminder_delivery plan_reminder_delivery[]
  trip                   Trip                     @relation(fields: [tripId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  members                TripPlanItemMember[]

  @@index([tripId])
  @@index([tripId, planDate])
  @@index([tripId, dayNumber])
  @@index([location])
  @@map("trip_plan_item")
}

model TripPlanItemMember {
  id             Int          @id @default(autoincrement())
  tripPlanItemId Int          @map("trip_plan_item_id")
  userId         Int          @map("user_id")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  tripPlanItem   TripPlanItem @relation(fields: [tripPlanItemId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tripPlanItemId, userId])
  @@index([tripPlanItemId])
  @@index([userId])
  @@map("trip_plan_item_member")
}

model MarketplaceListing {
  id                    Int                             @id @default(autoincrement())
  publicId              String                          @unique @map("public_id") @db.VarChar(32)
  createdById           Int                             @map("created_by_id")
  name                  String                          @map("name") @db.VarChar(255)
  description           String?                         @map("description") @db.VarChar(500)
  coverImageUrl         String?                         @map("cover_image_url") @db.VarChar(500)
  playProductId         String?                         @map("play_product_id") @db.VarChar(255)
  cityId                Int?                            @map("city_id")
  stateId               Int?                            @map("state_id")
  countryId             Int?                            @map("country_id")
