PORT=3000

# Firebase Cloud Messaging (Android push). Absolute path to the FCM
# service-account JSON. When unset, Android push is SILENTLY disabled —
# FcmPushAdapter logs a startup warning and every send resolves { sent: 0 }
# rather than failing loudly.
FCM_SERVICE_ACCOUNT_PATH=./keys/fcm-sa.json
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/oneplan?schema=public

# Object storage (Google Cloud Storage)
# Uses its own service account (STORAGE_SA_KEY_FILE), separate from the
# Vertex/Gemini SA (VERTEX_SA_KEY_FILE below). Media bucket is private
# (signed URLs only); the public bucket must have `allUsers:objectViewer`
# granted at the bucket IAM level for OG images served via /deeplinks.
# Leave STORAGE_SA_KEY_FILE empty to fall back to ADC for local dev.
GCS_MEDIA_BUCKET=oneplan-media
GCS_PUBLIC_BUCKET=oneplan-public
STORAGE_SA_KEY_FILE=./keys/storage-sa.json

# Auth
JWT_SECRET=your-jwt-secret-here-at-least-32-characters-long
JWT_REFRESH_SECRET=your-refresh-secret-here-at-least-32-characters-long
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=30d
APPLE_CLIENT_ID=com.yourcompany.oneplan # comma-separated list of iOS bundle ids accepted as Apple `aud`
# Web Sign in with Apple Services ID (NOT the iOS bundle id). Leave empty if web Apple sign-in is not configured yet.
APPLE_WEB_CLIENT_ID=
GOOGLE_CLIENT_ID=123456789.apps.googleusercontent.com
GOOGLE_PLAY_PACKAGE_NAME=com.yourcompany.oneplan
GOOGLE_PLAY_SERVICE_ACCOUNT_EMAIL=play-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PLAY_SERVICE_ACCOUNT_PRIVATE_KEY=
# Android counterpart of APP_STORE_ENVIRONMENT. One shared Play app/product
# set backs both dev- and prod-pointed builds, so Production must reject
# license-tester (test) purchases instead of granting Pro. Test|Production|Auto.
# Safe-by-default: unset/unconfigured => Production => rejects test purchases.
# local/dev MUST explicitly set Test to accept and label test purchases.
GOOGLE_PLAY_ENVIRONMENT=Production  # local/dev=Test, prod=Production
# Audience configured on the Pub/Sub push subscription that delivers Play
# Real-time Developer Notifications (RTDN) to our webhook — typically the
# full webhook URL. google-pubsub.guard.ts checks the OIDC token's `aud`
# claim against this value; if unset, the guard rejects every push with 401.
GOOGLE_PUBSUB_AUDIENCE=

# Android App Links (Digital Asset Links) — served at
# /.well-known/assetlinks.json so shared links / scanned QR open the Android
# app instead of the browser (counterpart of the iOS AASA). dev and prod are
# SEPARATE Play apps with separate packages AND separate signing certs, so
# assetlinks.json must carry one statement per package. Prefer
# ANDROID_APP_LINK_TARGETS below; the two vars after it are a legacy
# single-package fallback kept for backward compatibility.
#
# Semicolon-separated app entries of `package:fingerprint1,fingerprint2,...`.
# Include every valid cert per package (Play App Signing cert, upload cert,
# and the local debug cert for sideloaded QA builds). Leave a package's
# fingerprint list empty (or omit the var entirely) until its keystore is
# provisioned — an unconfigured package is skipped from the response and the
# server logs a startup WARNING; it never silently ships a malformed file.
# Example (dev cert values are the local debug + upload certs; the prod
# Play App Signing cert is fetched from Play Console separately):
# ANDROID_APP_LINK_TARGETS=com.oneplan.android:<PROD_PLAY_SIGNING_SHA256>;com.oneplan.android.dev:3A:54:C2:48:1E:AB:90:2E:E4:C9:92:0F:86:EA:20:1A:FC:CA:44:FF:42:4C:FD:F8:6F:00:D4:6F:44:CA:44:B3,F9:C2:79:EA:8B:E1:53:0C:84:4C:56:66:1A:BF:41:C8:F4:CE:92:66:94:B3:68:E5:16:75:ED:53:B8:07:67:EE
ANDROID_APP_LINK_TARGETS=

# Legacy single-package fallback, only read when ANDROID_APP_LINK_TARGETS is
# unset. Defaults to com.oneplan.android (the release applicationId).
ANDROID_APP_PACKAGE_NAME=com.oneplan.android
# Comma-separated uppercase SHA-256 signing-cert fingerprints. Include BOTH
# the Play App Signing cert AND the upload cert. Leave empty until the
# keystore is provisioned (the endpoint then serves an empty target list and
# autoVerify fails closed to the landing page).
ANDROID_APP_SHA256_CERT_FINGERPRINTS=

# Rate Limiting
THROTTLE_LIMIT=1000

# Gemini (receipt OCR + Board video understanding) — via Vertex AI
# Point VERTEX_SA_KEY_FILE at a service-account JSON granted
# `roles/aiplatform.user` + `roles/storage.objectAdmin` on the staging
# bucket below. Leave empty to fall back to ADC for local dev:
#   gcloud auth application-default login
# GOOGLE_CLOUD_LOCATION must be `global` for Gemini 2.5 — those models are
# only served from the global Vertex endpoint (regional hosts 404 them).
# The GCS bucket below can still live in any region (asia-southeast1 is
# closest to VN users for upload latency); it's independent of the model
# endpoint.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GCS_GEMINI_BUCKET=oneplan-pin-extractions
VERTEX_SA_KEY_FILE=./keys/vertex-sa.json
GEMINI_MODEL_ID=gemini-2.5-flash

# Path to the yt-dlp binary used to resolve Instagram/TikTok URLs to raw video files.
# Defaults to `yt-dlp` on $PATH. In Alpine the package installs it at /usr/bin/yt-dlp.
YT_DLP_PATH=yt-dlp

# Path to the gallery-dl binary used for TikTok photo (image carousel) posts,
# which yt-dlp does not support. Defaults to `gallery-dl` on $PATH.
GALLERY_DL_PATH=gallery-dl

# Exchange rates — https://www.exchangerate-api.com/ (v6)
# Free tier: 1,500 requests/month. Leave empty to skip live fetches (service falls back to cached/static rates).
EXCHANGERATE_API_KEY=

# Marketplace — sliding window (in days) used to compute Trending tab ranking
MARKETPLACE_TRENDING_WINDOW_DAYS=30

# Admin app + Dashboard app
# Comma-separated list of admin emails. Used by AdminGuard, /auth/admin/login, and the isAdmin flag on /auth/me.
ADMIN_EMAILS=admin@example.com
# Comma-separated CORS origins for the user-facing dashboard (Vite dev: 5173).
DASHBOARD_WEB_ORIGINS=http://localhost:5173
# Comma-separated CORS origins for the OnePlan Admin app (Vite dev: 5174).
ADMIN_WEB_ORIGINS=http://localhost:5174
TRACTION_WEB_ORIGINS=http://localhost:5175

#APN
APNS_KEY_ID=XXXXXXXXXX        # Key ID from step 2
APNS_TEAM_ID=YYYYYYYYYY       # Team ID from step 2
APNS_KEY_PATH=./keys/AuthKey_XXXXXXXXXX.p8
APNS_BUNDLE_ID=com.oneplan.app  # Your iOS app bundle identifier
APNS_PRODUCTION=false           # Use 'true' for App Store builds

# App Store Connect (In-App Purchases / Subscriptions)
APP_STORE_ISSUER_ID=           # From App Store Connect > Users > Keys (Issuer ID)
APP_STORE_KEY_ID=              # In-App Purchase key ID from App Store Connect
APP_STORE_BUNDLE_ID=com.yourcompany.OnePlan  # e.g., com.yourcompany.OnePlan
APP_STORE_PRIVATE_KEY=         # Base64-encoded contents of the .p8 private key file
APP_STORE_ENVIRONMENT=Sandbox  # Sandbox or Production
APP_STORE_APP_APPLE_ID=        # Numeric App ID from App Store Connect (e.g., 1234567890)

# Scan-credit ledger (Board/Pin). SIGNUP_BONUS is granted once at account
# creation. Pro plans grant the FULL per-billing-cycle amount upfront on the
# initial purchase and again on every Apple auto-renewal (the
# _PRO_WEEKLY/_MONTHLY/_YEARLY suffix names the Pro SKU, not a cadence).
# pay_once is a one-time grant. Defaults match the values committed in code;
# override here to tune without a redeploy.
SIGNUP_BONUS_SCAN_CREDITS=2
SCAN_GRANT_PRO_WEEKLY=3
SCAN_GRANT_PRO_MONTHLY=20
SCAN_GRANT_PRO_YEARLY=300
SCAN_GRANT_PAY_ONCE=10
# App-update reward: 5 credits once per (user, app version) when the iOS client
# reports running a version >= MIN_VERSION. Set _ENABLED=false to pause the
# promotion (requires a server restart — env is read once at startup).
SCAN_GRANT_APP_UPGRADE=5
SCAN_GRANT_APP_UPGRADE_ENABLED=true
SCAN_GRANT_APP_UPGRADE_MIN_VERSION=1.2.5

# Telegram marketing bot (offer-code distribution). Prod only — Telegram allows
# one long-poll consumer per token, so do NOT set BOT_ENABLED=true in more than
# one environment. The bot greets each new member of the group by first name;
# CAMPAIGN_ENABLED is the marketing window that attaches a "Get Code" button to
# the greeting (tap → bot DMs an offer code). The bot must be an ADMIN of the
# group so Telegram delivers chat_member (join) updates. GROUP_ID restricts
# greetings to that group; WELCOME_TEXT overrides the default bilingual greeting
# and may contain {name}.
TELEGRAM_BOT_ENABLED=false
TELEGRAM_CAMPAIGN_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_GROUP_ID=

# Trip auto-start cron: every 15 min, PLANNING trips whose start date has
# arrived (in the trip country's timezone) become ONGOING. Set false to disable.
TRIP_AUTO_START_ENABLED=true

# Engagement push engine (daily personalized re-engagement nudges).
# ENGAGEMENT_ENABLED gates the cron entirely (default off — keep false until a
# launch); the per-trigger flags allow dark-launching one trigger at a time.
# No engagement push is sent to a user until they have explicitly opted in
# (consent stamped via PATCH /auth/me), regardless of these flags.
ENGAGEMENT_ENABLED=false
ENGAGEMENT_TRIGGER_UNFINISHED=true
ENGAGEMENT_TRIGGER_WEATHER=true
ENGAGEMENT_TRIGGER_DORMANT=true
ENGAGEMENT_TRIGGER_NEW_PLAN=true
# Re-engage users with no app session in this many days.
ENGAGEMENT_DORMANT_DAYS=14
# Local daytime send window [start, end) per user's timezone — no night-time pings.
ENGAGEMENT_SEND_START_HOUR=10
ENGAGEMENT_SEND_END_HOUR=20
# Unfinished-plan trigger: only nag a trip created at least N hours ago whose
# plan still has fewer than THRESHOLD items.
ENGAGEMENT_UNFINISHED_MIN_AGE_HOURS=24
ENGAGEMENT_UNFINISHED_PLAN_THRESHOLD=3
# New-plan trigger: only surface marketplace listings created within N days.
ENGAGEMENT_NEW_PLAN_LOOKBACK_DAYS=14

# Weather (Google Maps Platform Weather API — commercial-friendly, same GCP
# org as Vertex/GCS). This is a Maps Platform API KEY (NOT the Vertex/GCS
# service account); create it in GCP and restrict it to the Weather API.
# Leave empty to disable the weather trigger gracefully (the other triggers
# still work). 10k calls/mo free, then $0.15/1k; per-city caching keeps usage low.
GOOGLE_MAPS_WEATHER_API_KEY=
# Temperature thresholds (°C) that classify a city as HOT / COLD for nudge copy.
WEATHER_HOT_C=33
WEATHER_COLD_C=12
# Fallback IANA timezone for the send-window when a user has no trip city.
WEATHER_DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh

# Plan-route day map (Mapbox Directions API, driving profile — worldwide).
# Google Routes API is not an option: Vietnam (our billing country) is a Google
# Maps Platform Prohibited Territory. Use a dedicated Mapbox access token for the
# server (default public scopes are enough). Leave empty to disable gracefully:
# pins still return, legs fall back to straight lines (no 500). 100k free
# requests/mo, then $2/1k. Results are NOT cached server-side — Mapbox Product
# Terms §2.10.1 forbid caching/storing Navigation API results.
MAPBOX_ACCESS_TOKEN=

# Solana / web3 vault (phase 1)
# Server-side kill switch. false (default) = /trips/:id/vault/*, /wallet*,
# /auth/wallet-token and the vault-leave / end-request endpoints answer 404, the
# vault crons do nothing and joinTrip skips vault sync — whatever SOLANA_* holds.
# Set true only on servers that should serve the group wallet.
WEB3_ENABLED=false
# Empty or malformed values switch the feature off with an error log; they never
# stop the server booting. In production RPC url + USDC mint must be set
# explicitly (the defaults are devnet).
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
SOLANA_COMMITMENT=confirmed
# Base58 secret key of the fee payer. Empty disables all vault endpoints.
SOLANA_FEE_PAYER_SECRET_KEY=
# Owner of the wallet that receives USDC on a merchant payment. Phase 1 mock only.
# NODE_ENV=production refuses to boot with either key set while the mock payout
# provider is the only binding (users would pay real USDC and get no fiat).
SOLANA_RECEIVER_SECRET_KEY=
# Optional: owner of the treasury ATA that receives the deposit fee (default: fee payer).
SOLANA_TREASURY_OWNER=
# Mock payout behaviour: success | failed | timeout | unknown
MOCK_PAYOUT_OUTCOME=success
# Personal-wallet withdrawal limits per user, micro-USDC (1_000_000 = 1 USDC).
WALLET_WITHDRAW_MIN_MICRO=1000000
WALLET_WITHDRAW_DAILY_CAP_MICRO=1000000000
WALLET_JWT_PRIVATE_KEY_FILE=./keys/wallet-jwt-private.pem

# Zalo OA / ZNS (fare-watch "Radar" alerts + OTP)
# App tai developers.zalo.me linked to the OnePlan OA. ZALO_OA_REFRESH_TOKEN is
# only the BOOTSTRAP value; after the first refresh the rotating token pair
# lives in the zalo_oauth_token table.
ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_OA_REFRESH_TOKEN=
# Approved ZNS template ids (OTP template is the authentication type)
ZNS_OTP_TEMPLATE_ID=
ZNS_ALERT_TEMPLATE_ID=

# Travelpayouts (fare-watch price source + affiliate)
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=
# Set to "false" to pause the fare sweep cron without redeploying
FARE_WATCH_ENGINE_ENABLED=true
# Absolute base for click-tracking links inside ZNS messages
PUBLIC_API_BASE=https://api.oneplan.space

# Solana Mobile hackathon build (all optional; faucet and Seeker identity stay off when unset, SIWS defaults apply)
# SIWS: wallet-link challenge. Domain is what the wallet shows and the server verifies (no scheme).
SIWS_DOMAIN=oneplan.space
SIWS_CHAIN_ID=solana:devnet
# Devnet-only test-USDC faucet (POST /web3/faucet). Needs WEB3_ENABLED + Solana keys too.
# SOLANA_FAUCET_SECRET_KEY is a bs58 secret key whose USDC ATA holds the devnet USDC to give away.
WEB3_FAUCET_ENABLED=false
SOLANA_FAUCET_SECRET_KEY=
FAUCET_USDC_MICRO=5000000
# Android wallet (served as GET /web3/eligibility mwaEnabled): true = the member's own wallet app
# over Mobile Wallet Adapter, false = the Privy embedded wallet. iOS always uses Privy. Flipping it
# needs no app build; members seated in an open vault under their MWA key can't sign after a flip
# to Privy (wallet_locked_by_vault) until that vault closes.
WEB3_MWA_ENABLED=true
# Mainnet READ RPC for Seeker Genesis Token / .skr lookups. Must allow getProgramAccounts
# (the .skr reverse lookup uses it; public api.mainnet-beta.solana.com usually rejects it) -
# e.g. a Helius free-tier URL. Empty = Seeker identity off.
SOLANA_MAINNET_RPC_URL=
