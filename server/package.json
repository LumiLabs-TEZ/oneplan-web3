{
  "name": "OnePlanServer",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed:countries": "tsx prisma/seeds/countries.ts",
    "prisma:seed:trip-members": "tsx prisma/seeds/trip-members.ts",
    "prisma:seed:trip-dalat": "tsx prisma/seeds/trip-dalat.ts",
    "prisma:seed:create-user": "tsx prisma/seeds/create-user.ts",
    "prisma:seed:settlement-test": "tsx prisma/seeds/settlement-test.ts",
    "prisma:seed:marketplace": "tsx prisma/seeds/marketplace-listings.ts",
    "backfill:thumbs": "tsx --env-file=.env scripts/backfill-thumbs.ts",
    "merge:listing-dupes": "tsx --env-file=.env scripts/merge-en-listing-duplicates.ts",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "openapi:generate": "nest build && node dist/src/scripts/generate-openapi.js",
    "idl:sync": "bash scripts/sync-idl.sh"
  },
  "dependencies": {
    "@apple/app-store-server-library": "^3.0.0",
    "@aws-sdk/client-s3": "^3.1011.0",
    "@aws-sdk/s3-request-presigner": "^3.1011.0",
    "@coral-xyz/anchor": "0.32.1",
    "@fastify/cors": "^11.2.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/static": "^9.0.0",
    "@google-cloud/storage": "^7.19.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-fastify": "^11.1.17",
    "@nestjs/platform-ws": "^11.1.17",
    "@nestjs/schedule": "^6.1.1",
    "@nestjs/swagger": "^11.2.6",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.1.17",
    "@onsol/tldparser": "1.2.1",
    "@parse/node-apn": "^7.1.0",
    "@prisma/client": "^6.15.0",
    "@solana/spl-token": "0.4.15",
    "@solana/wallet-standard-util": "1.1.4",
    "@solana/web3.js": "1.98.4",
    "@supabase/supabase-js": "^2.105.3",
    "archiver": "^7.0.1",
    "bad-words": "^3.0.4",
    "bcrypt": "^6.0.0",
    "bn.js": "^5.2.5",
    "borsh": "^2.0.0",
    "bs58": "^6.0.0",
    "buffer": "6.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "fastify": "^5.8.4",
    "firebase-admin": "^13.9.0",
    "geoip-lite": "^2.0.3",
    "google-auth-library": "^10.6.2",
    "grammy": "^1.30.0",
    "joi": "^18.0.2",
    "jose": "^6.2.1",
    "nanoid": "^3.3.12",
    "nestjs-cls": "^6.2.0",
    "prisma": "6.15.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.34.2",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@fastify/busboy": "^3.2.0",
    "@fastify/error": "^4.2.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/archiver": "^6.0.4",
    "@types/bcrypt": "^6.0.0",
    "@types/bn.js": "^5.2.0",
    "@types/geoip-lite": "^1.4.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/ws": "^8.18.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": "(src|test)/.*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "transformIgnorePatterns": [
      "node_modules/\\.pnpm/(?!uuid@|rpc-websockets@)"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "bcrypt",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  }
}
