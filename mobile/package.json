{
  "name": "@oneplan/mobile",
  "main": "index.js",
  "version": "1.5.0",
  "private": true,
  "packageManager": "pnpm@10.25.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"scripts/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "api:gen": "openapi-typescript ../openapi/openapi.json -o src/api/schema.d.ts",
    "api:check": "pnpm api:gen && git diff --exit-code -- src/api/schema.d.ts",
    "i18n:gen": "tsx scripts/xcstrings-to-i18n.ts",
    "i18n:check": "pnpm i18n:gen && git diff --exit-code -- src/i18n/locales src/i18n/infoplist",
    "doctor:expo": "expo-doctor",
    "check:google": "tsx scripts/check-google-client-id.ts",
    "i18n:add": "tsx scripts/add-xcstrings-keys.ts",
    "release:check": "APP_VARIANT=prod tsx scripts/release/check.ts",
    "release:acceptance": "python3 scripts/parity/acceptance.py",
    "eas-build-post-install": "if [ \"$EAS_BUILD_PROFILE\" = \"production\" ]; then pnpm release:check --credentials; fi"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.7",
    "@ethersproject/shims": "^5.8.0",
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.1.1",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@noble/curves": "1.9.7",
    "@noble/hashes": "1.8.0",
    "@privy-io/expo": "^0.74.3",
    "@privy-io/expo-native-extensions": "^0.0.12",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-native-menu/menu": "^2.0.0",
    "@shopify/flash-list": "2.0.2",
    "@shopify/react-native-skia": "2.6.2",
    "@solana-mobile/mobile-wallet-adapter-protocol": "2.3.0",
    "@solana-mobile/mobile-wallet-adapter-protocol-web3js": "2.3.0",
    "@solana/web3.js": "^1.99.0",
    "@tanstack/query-persist-client-core": "^5.102.8",
    "@tanstack/react-query": "^5.102.8",
