# Public OAuth client ids (safe to commit real values; app.config.ts has the same defaults,
# so a .env is only needed to override them locally). EAS profiles set them per environment.
# Web client id = the server's GOOGLE_CLIENT_ID (audience the server verifies).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=66936502756-llt4amv7b9fsjbit5gtu08snu0b9fjip.apps.googleusercontent.com
# iOS client id from ios/OnePlan/OnePlan/Info.plist GIDClientID
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=559176877871-535pl0kskgdabrdg41h6nr03ira3vvmk.apps.googleusercontent.com
# Reversed iOS client id, registered as a URL scheme by the google-signin plugin
GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.559176877871-535pl0kskgdabrdg41h6nr03ira3vvmk
# local|dev|prod (default dev)
APP_VARIANT=dev

# Point the simulator at a local API for `expo start` (physical devices need a devtunnel/LAN URL)
API_URL=http://localhost:3000

# Android Google Maps SDK key (android.config.googleMaps.apiKey in app.config.ts)
GOOGLE_MAPS_ANDROID_API_KEY=
# iOS Google Maps SDK key (react-native-maps plugin `iosGoogleMapsApiKey`; GCP lumilabs-oneplandev,
# "OnePlan iOS dev (Maps)", bundle-id restricted)
GOOGLE_MAPS_IOS_API_KEY=
# Foursquare Places API key (extra.foursquareApiKey in app.config.ts)
FOURSQUARE_API_KEY=
